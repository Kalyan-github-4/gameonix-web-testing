# ---------------------------------------------------------------- database --
# Postgres connection string used by Drizzle and by drizzle-kit.
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# A password containing @ : / ? # must be percent-encoded. Neon and other
# hosted providers require sslmode=require.
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/gamonix"

# ------------------------------------------------------------------- links --
# Absolute public origin. Verification links are emailed, so a relative URL is
# useless — this must be set in production.
APP_URL="http://localhost:3000"

# Keys every verification token and OTP digest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VERIFICATION_TOKEN_PEPPER=""

# ------------------------------------------------------------------- email --
# "smtp" sends through nodemailer; "resend" through the Resend API.
MAIL_PROVIDER="smtp"

# Gmail requires a 16-character App Password (Google Account → Security →
# 2-Step Verification → App passwords), never the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD=""
# Must be the authenticated mailbox for Gmail; defaults to SMTP_USER.
MAIL_FROM="Gamonix <you@gmail.com>"

# Only read when MAIL_PROVIDER="resend". Until a sending domain is verified,
# MAIL_FROM must stay on onboarding@resend.dev and only reaches the account owner.
RESEND_API_KEY=""

# --------------------------------------------------------------------- sms --
# "fast2sms" sends real OTPs to Indian numbers. "console" prints codes to the
# server log and echoes them to the browser in development; it refuses to run
# in production.
SMS_PROVIDER="fast2sms"
# Fast2SMS → Dev API → API key.
FAST2SMS_API_KEY=""

# ------------------------------------------------------------------- admin --
# HTTP Basic credentials for /admin/registrations, which lists every player's
# name, phone and email. Both must be set or the page denies everyone.
ADMIN_USER="organizer"
ADMIN_PASSWORD=""

# ----------------------------------------------------------------- storage --
# Set automatically by Vercel when a Blob store is attached to the project.
# When present, team logos upload to Blob; when absent they are written to
# public/uploads, which only works on a host with a persistent disk.
BLOB_READ_WRITE_TOKEN=""

# Master switch for every outbound link and code.
VERIFICATION_ENABLED="true"
