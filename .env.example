# Postgres connection string used by Drizzle.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gamonix"

# Absolute public origin. Verification links are emailed, so a relative URL is
# useless — this must be set in production.
APP_URL="http://localhost:3000"

# Keys every verification token and OTP digest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VERIFICATION_TOKEN_PEPPER=""

# Resend (https://resend.com/api-keys). Until a sending domain is verified,
# MAIL_FROM must stay on onboarding@resend.dev and only reaches the account owner.
RESEND_API_KEY=""
MAIL_FROM="Gamonix <onboarding@resend.dev>"

# OTP delivery. "console" prints codes to the server log and echoes them to the
# browser in development; it refuses to run in production.
SMS_PROVIDER="console"

# Master switch for every outbound link and code.
VERIFICATION_ENABLED="true"
